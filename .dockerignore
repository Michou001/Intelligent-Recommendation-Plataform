# Keep the build context small: only src/, artifacts/, pyproject.toml and the
# few data files the web UI reads (listed with ! below) are copied.
.git
.github
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
tests
benchmarks
docs
reports/*
!reports/arranque_en_frio.json
!reports/evaluation_report.json
datasets/*
!datasets/peliculas_es.csv
k8s
# Intermediate and regenerated artifacts are not needed to serve requests.
artifacts/interim
artifacts/evaluation
artifacts/logs
artifacts/retry_buffer.jsonl
